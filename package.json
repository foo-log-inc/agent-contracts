{
  "name": "agent-contracts",
  "version": "0.35.10",
  "description": "Declarative YAML DSL toolkit for defining, validating, and rendering multi-agent development workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-contracts": "dist/agent-contracts.bundle.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/agent-contracts.bundle.mjs",
    "dist/agent-contracts.bundle.mjs.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dsl_base",
    "cli-contract.yaml",
    "docs/cli-reference.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "generate:schema": "tsx scripts/generate-json-schema.ts",
    "generate:cli": "cli-contracts generate typescript",
    "generate:docs": "cli-contracts docs",
    "prepublishOnly": "npm run clean && npm run build && npm run bundle:min",
    "test:ci": "vitest run",
    "bundle": "node esbuild.bundle.mjs",
    "bundle:min": "node esbuild.bundle.mjs --minify"
  },
  "keywords": [
    "agent",
    "multi-agent",
    "workflow",
    "yaml",
    "dsl",
    "validation",
    "lint",
    "prompt-rendering",
    "handoff",
    "typescript",
    "ai-development"
  ],
  "author": "foo-log-inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-log-inc/agent-contracts.git"
  },
  "homepage": "https://github.com/foo-log-inc/agent-contracts#readme",
  "bugs": {
    "url": "https://github.com/foo-log-inc/agent-contracts/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-core": "^1.24.1",
    "@stoplight/spectral-functions": "^1.11.1",
    "@stoplight/spectral-rulesets": "^1.23.1",
    "@types/node": "^26.6.6",
    "agent-contracts-runtime": "^0.36.15",
    "ajv": "^8.18.0",
    "cli-contracts": "^0.34.12",
    "commander": "^14.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "handlebars": "^4.7.10",
    "minimatch": "^11.0.8",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "eslint": {
      "minimatch": "$minimatch"
    },
    "@eslint/config-array": {
      "minimatch": "$minimatch"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "$minimatch"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
